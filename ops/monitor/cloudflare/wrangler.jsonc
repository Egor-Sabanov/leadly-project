{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadly-owner-monitor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "OWNER_MONITOR", "class_name": "OwnerMonitor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OwnerMonitor"] }],
  "observability": { "enabled": true }
}
