# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon/public key. Never use service_role here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLIC_KEY
# Legacy alternative, if your dashboard only shows anon/public:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only: never prefix this key with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Long random secret used to protect the ingestion endpoint
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# One HTTPS RSS/Atom feed URL per line (or comma-separated). Start with sources you are allowed to use.
LEADLY_RSS_FEEDS=
