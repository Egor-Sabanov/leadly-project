# Production canonical origin, e.g. https://your-domain.example (no trailing path).
LEADLY_SITE_URL=

# Required: public app configuration. Copy to .env.local; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative supported by both browser and server:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: required for avatar uploads, trusted ingestion and AI quota. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Случайная строка от 16 символов; только сервер. Vercel передаёт её cron-запросам.
CRON_SECRET=
# Official project RSS feeds; comma/newline separated. Empty disables RSS.
LEADLY_RSS_FEEDS=https://www.fl.ru/rss/all.xml,https://freelancehunt.com/projects.rss
# Official Freelancehunt API token; optional.
FREELANCEHUNT_API_TOKEN=

# Optional OpenAI Responses API. Templates work without these values.
LEADLY_AI_API_KEY=
LEADLY_AI_MODEL=gpt-4.1-mini

# Optional Telegram incoming webhook. Set a long random secret via setWebhook.secret_token.
# Only explicitly authorized PUBLIC channels are accepted; add the bot with permission.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
# Explicit feed classification: project, job, or client. No implicit classification.
TELEGRAM_OPPORTUNITY_TYPE=

# Russian digital vacancies, official HH API (service-role key and cron secret also required).
LEADLY_HH_ENABLED=false
# Empty query: 12 profession searches, max 5 results each. A custom query uses one search (max 20).
LEADLY_HH_QUERY=
# Optional comma-separated IDs from lib/disciplines.ts; empty = all directions.
LEADLY_HH_DISCIPLINES=
# Optional official HH API application token, if required by the provider.
HH_API_TOKEN=
# Optional custom providers must first be configured in Supabase; secrets stay there.
LEADLY_VK_AUTH_PROVIDER=custom:vk
LEADLY_YANDEX_AUTH_PROVIDER=custom:yandex

# Optional per-channel types. Overrides the legacy single-type list; maximum 50 public channel IDs.
# Example: [{"chatId":"-1001234567890","type":"project","name":"Authorised projects"}]
TELEGRAM_CHANNEL_RULES=
# A bot token is needed only to register/check the webhook with official Bot API; never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Server-side operations console: comma-separated Supabase user UUIDs of deployment operators.
# Never use a NEXT_PUBLIC_ prefix. Leave empty to deny access to /sources for every account.
LEADLY_OPERATOR_USER_IDS=
