{
  "name": "leadly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:rss": "node scripts/test-rss-ingestion.cjs",
    "test:scoring": "node test-opportunity-scoring-v14.cjs",
    "test:mvp": "node scripts/test-mvp.cjs",
    "test:db": "node scripts/test-database.cjs && node scripts/test-vk-accounts-db.cjs",
    "test": "npm run test:rss && npm run test:scoring && npm run test:mvp && npm run test:db && npm run test:russian-auth && npm run test:auth && npm run test:discovery && npm run test:news && npm run test:assets && npm run test:deployment && npm run test:ingestion && npm run test:telegram && npm run test:feed",
    "test:auth": "node scripts/test-auth-completion.cjs && node scripts/test-yandex-userinfo.cjs && node scripts/test-vk-oauth.cjs && node scripts/test-vk-account-oauth.cjs && node scripts/test-vk-account-service.cjs",
    "check": "npm run lint && npm test && npm run build",
    "test:ui": "playwright test",
    "test:russian-auth": "node scripts/test-russian-auth.cjs",
    "test:discovery": "node scripts/test-discovery.cjs",
    "test:news": "node scripts/test-news.cjs",
    "telegram:setup": "node scripts/setup-telegram.cjs",
    "setup:profile-storage": "node --env-file-if-exists=.env.local scripts/setup-profile-storage.cjs",
    "sources:sync": "node --env-file-if-exists=.env.local scripts/sync-sources.cjs",
    "test:assets": "node scripts/test-account-assets.cjs && node scripts/test-outreach-selection.cjs",
    "check:readiness": "node --env-file-if-exists=.env.local scripts/check-readiness.cjs",
    "check:deployment": "node --env-file-if-exists=.env.local scripts/check-deployment.cjs",
    "test:deployment": "node scripts/test-deployment.cjs",
    "test:ingestion": "node scripts/test-scheduled-ingestion.cjs && node scripts/test-runtime-health.cjs",
    "test:feed": "node scripts/test-feed-selection.cjs",
    "test:telegram": "node scripts/test-telegram-security.cjs && node scripts/test-telegram-database.cjs && node scripts/test-telegram-workspace.cjs && node scripts/test-telegram-command-sync.cjs",
    "check:operations": "node --env-file-if-exists=.env.local scripts/check-operations.cjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "20.17.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "9.21.0",
    "eslint-config-next": "16.4.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": "24.x"
  }
}
